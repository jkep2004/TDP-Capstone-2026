#!/usr/bin/env bash

set -euo pipefail

# Configuration
RESOURCE_GROUP="${AZURE_RESOURCE_GROUP:-rg-tdp2026-carbon-team3-dev}"
SQL_SERVER="${AZURE_SQL_SERVER_NAME:-sql-tdp2026-carbon-team3-dev}"

RULE_NAME="${FIREWALL_RULE_NAME:-local-dev-$(whoami)}"

# Check dependencies
for cmd in az curl; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "ERROR: $cmd is not installed."
        exit 1
    fi
done

# Authenticate with Azure
if ! az account show >/dev/null 2>&1; then
    echo "ERROR: Not authenticated with Azure."
    echo "Run az login or configure Service Principal credentials."
    exit 1
fi

# Detect public IP
echo "Detecting public IP..."

PUBLIC_IP=$(curl -4 -sf https://api.ipify.org || \
            curl -4 -sf https://ifconfig.me)

if [[ ! "$PUBLIC_IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo "ERROR: Could not determine a valid public IPv4 address."
    exit 1
fi

echo "Detected public IP: $PUBLIC_IP"

# Add Azure SQL firewall rule
echo "Adding firewall rule '$RULE_NAME'..."

az sql server firewall-rule create \
    --resource-group "$RESOURCE_GROUP" \
    --server "$SQL_SERVER" \
    --name "$RULE_NAME" \
    --start-ip-address "$PUBLIC_IP" \
    --end-ip-address "$PUBLIC_IP" \
    --output table

# Verify rule
echo "Verifying firewall rule..."

az sql server firewall-rule show \
    --resource-group "$RESOURCE_GROUP" \
    --server "$SQL_SERVER" \
    --name "$RULE_NAME" \
    --output table

echo ""
echo "SUCCESS: IP $PUBLIC_IP whitelisted."
echo "Azure SQL Server: $SQL_SERVER"
echo "Firewall rule: $RULE_NAME"
echo ""
echo "Allow up to 5 minutes for the firewall change to propagate."